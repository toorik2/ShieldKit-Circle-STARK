{
  "name": "glm-occupancy-c-lane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Research lane (GLM): SHA residuals in occupancy composition C, carried from the e0b0de3 fused-N lock. RULES.md is the constitution; vk changes if any ruleset line changes.",
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "cli": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "rust:test": "cargo test --manifest-path crates/circle-fri-worker/Cargo.toml",
    "rust:prove": "cargo run --quiet --manifest-path crates/circle-fri-worker/Cargo.toml",
    "rust:xcheck": "tsx scripts/rust-xcheck.ts"
  },
  "engines": {
    "node": ">=20.10"
  },
  "dependencies": {
    "@bitauth/libauth": "3.1.0-next.8",
    "cashc": "0.14.0-next.4",
    "nostr-tools": "2.15.0"
  },
  "devDependencies": {
    "@types/node": "22.16.5",
    "tsx": "4.20.3",
    "typescript": "5.8.3"
  }
}
